{
  "name": "saudi-education-expo-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed.js",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mailtrap": "^4.8.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "effect": "3.20.0",
    "esbuild": "0.28.1"
  }
}
